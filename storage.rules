rules_version = '2';

// Replaces the console's old catch-all (any signed-in account could read,
// list, overwrite and delete everything — including every vendor's ID
// photos). Covers every path the web and mobile apps upload to (Cloud
// Functions don't touch Storage). Nothing in the apps deletes or overwrites a stored
// image — every upload gets a fresh timestamped name — so image paths are
// create-only: nobody can replace another store's logo/product photo in
// place, even though the flat web paths carry no owner to check.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }
    function underMB(mb) {
      return request.resource.size < mb * 1024 * 1024;
    }

    // KYC documents: Ghana Card photos / company certificate, uploaded at
    // vendor signup (web create-store, mobile registration) and on
    // resubmit. Owner-only. Read is owner-only too — getDownloadURL needs
    // it right after upload; the super admin opens the token-bearing URL
    // saved on users/{uid}, which firestore.rules keeps owner/admin-only.
    match /verifications/{uid}/{file} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid
        && underMB(10)
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf');
    }

    // Storefront images. Shoppers (signed in or not) load them through the
    // token-bearing download URLs saved on products/stores, which bypass
    // these rules — the SDK only reads here for getDownloadURL right after
    // an upload. So: signed-in get, no list (nothing in the apps lists
    // files; the old catch-all let any account enumerate every folder). No
    // content-type check: older mobile builds upload a bare blob.
    match /stores/{storeId}/{allPaths=**} {
      allow get: if signedIn();
      allow create: if signedIn() && underMB(10);
    }
    match /products/{file} {
      allow get: if signedIn();
      allow create: if signedIn() && underMB(10);
    }
    match /uploads/{file} {
      allow get: if signedIn();
      allow create: if signedIn() && underMB(10);
    }
  }
}

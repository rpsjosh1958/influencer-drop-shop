rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read for stores (needed for Store Selector)
    match /stores/{storeId} {
      allow read: if true;
      allow write: if request.auth != null; // Basic protection
      
      // Allow access to subcollections
      match /products/{productId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
      match /categories/{categoryId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
      match /orders/{orderId} {
        allow create: if true; // Allow anyone to place order
        allow read, update: if request.auth != null; // Only store owner/user can see
      }
    }

    // Global Categories (if using them outside of stores)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default deny for other collections unless explicitly allowed
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}

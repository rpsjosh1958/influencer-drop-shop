rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isStoreOwner() {
      // successful update requires user to be the owner stored on the existing doc
      return isAuthenticated() && request.auth.uid == resource.data.ownerId;
    }
    
    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/super_admins/$(request.auth.uid));
    }

    // --- Super Admins ---
    match /super_admins/{userId} {
      allow read: if true; // or restrictive 
    }

    // --- Users (SENSITIVE DATA) ---
    // Contains Phone, Ghana Card, Email. STRICT ACCESS.
    match /users/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow write: if isOwner(userId);
    }
    
    // --- System Logs ---
    match /system_logs/{logId} {
      allow read: if isSuperAdmin();
    }

    // --- Stores ---
    match /stores/{storeId} {
      // Public can view stores (for shopping)
      allow read: if true;
      
      // Authenticated users can create a store
      allow create: if isAuthenticated();
      
      // Only the owner can edit their store settings (Name, Theme, etc.)
      allow update, delete: if isStoreOwner();

      // Helper for subcollections to check parent store ownership
      function isParentStoreOwner() {
        return isAuthenticated() && get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId == request.auth.uid;
      }

      // -- Products --
      match /products/{productId} {
        allow read: if true;
        allow write: if isParentStoreOwner();
        // Allow public to update ONLY the 'stock' field (decrement) during checkout
        // This is a loose rule for MVP; ideally use Cloud Functions
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'updatedAt']);
      }
      
      // -- Categories --
      match /categories/{categoryId} {
        allow read: if true;
        allow write: if isParentStoreOwner();
      }
      
      // -- Orders --
      match /orders/{orderId} {
        // Anyone can place an order (Public Checkout)
        allow create: if true;
        
        // Store Owner OR The Customer who placed it can read
        allow read: if isParentStoreOwner() || (isAuthenticated() && resource.data.userId == request.auth.uid);
        
        // Only the store owner can update (e.g. status)
        allow update: if isParentStoreOwner();
      }

      // -- Reviews --
      match /reviews/{reviewId} {
        // Anyone can read reviews
        allow read: if true;
        // Only authenticated users can create reviews
        allow create: if isAuthenticated();
        // Only Store Owner can update (moderation)
        allow update, delete: if isParentStoreOwner();
      }

      // -- Complaints --
      match /complaints/{complaintId} {
        // Anyone can file a complaint
        allow create: if true;
        
        // Only the Store Owner can read or update (resolve) complaints
        allow read, update: if isParentStoreOwner();
      }

      // -- Wallet & Transactions -- (Sensitive, Owner Only)
      match /wallet/{document=**} {
        allow read: if isParentStoreOwner();
      }
      match /wallet_transactions/{transactionId} {
        allow read: if isParentStoreOwner();
      }

      // -- Vendor Tickets (To Platform) --
      match /tickets/{ticketId} {
        allow create: if isParentStoreOwner();
        allow read: if isParentStoreOwner() || isSuperAdmin();
        allow update: if isSuperAdmin(); // Admins resolve tickets
      }

      // -- Services (For service-based stores) --
      match /services/{serviceId} {
        allow read: if true; // Public can view services
        allow create, update, delete: if isParentStoreOwner();
      }

      // -- Availability Settings (Store schedule) --
      match /availability/{docId} {
        allow read: if true; // Public can check available slots
        allow create, update, delete: if isParentStoreOwner();
      }

      // -- Bookings (Appointments) --
      match /bookings/{bookingId} {
        // Anyone can create a booking (public checkout)
        allow create: if true;
        
        // Store Owner can read all bookings for their store
        // Authenticated customers can read their own bookings
        allow read: if isParentStoreOwner() || 
          (isAuthenticated() && resource.data.customerId == request.auth.uid) ||
          true; // For now, allow public read during development - tighten later
        
        // Only the store owner can update (confirm, cancel, complete)
        allow update: if isParentStoreOwner();
        
        // Store owner can delete bookings
        allow delete: if isParentStoreOwner();
      }
    }

    // --- Notifications (Root) ---
    match /notifications/{notificationId} {
        allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.userId == 'all');
        allow create: if isAuthenticated();
        // User can mark their own notifications as read
        allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Default Deny (Block everything else)
    match /{document=**} {
      allow read, write: if false;
    }
    
    // --- Collection Groups (Global Search/Listing) ---
    match /{path=**}/complaints/{complaintId} {
      allow read: if isSuperAdmin();
    }
    match /{path=**}/tickets/{ticketId} {
      allow read: if isSuperAdmin();
    }
    match /{path=**}/orders/{orderId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    match /{path=**}/notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    match /{path=**}/products/{productId} {
      allow read: if true;
    }
    match /{path=**}/services/{serviceId} {
      allow read: if true;
    }
    match /{path=**}/bookings/{bookingId} {
      allow read: if isAuthenticated() && resource.data.customerId == request.auth.uid;
    }
  }
}

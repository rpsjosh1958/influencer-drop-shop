rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isStoreOwner() {
      // successful update requires user to be the owner stored on the existing doc
      return isAuthenticated() && request.auth.uid == resource.data.ownerId;
    }
    
    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/super_admins/$(request.auth.uid));
    }

    // A second+ store requires the Growth plan (the "Add New Store" UI
    // already disables this for starter — this is the server-side half of
    // that gate, since a direct client write bypassed it entirely before).
    // A user's very first store is always allowed regardless of plan.
    function isOnGrowthOrHasNoStores() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        || !('ownedStores' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ownedStores.size() == 0
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.plan == 'growth';
    }

    // --- Super Admins ---
    match /super_admins/{userId} {
      allow read: if true; // or restrictive 
    }

    // --- Users (SENSITIVE DATA) ---
    // Contains Phone, Ghana Card, Email. STRICT ACCESS.
    match /users/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow create: if isOwner(userId);
      // Plan/billing fields are server-side only (set by verified payment
      // Cloud Functions or the trial/expiry triggers) — a client write here
      // would let a user grant themselves the Growth plan for free.
      allow update: if isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(
          ['plan', 'planExpiresAt', 'planStartedAt', 'isTrial', 'hasUsedTrial', 'billingCycle']
        );
      allow delete: if isOwner(userId);
    }
    
    // --- System Logs ---
    match /system_logs/{logId} {
      allow read: if isSuperAdmin();
    }

    // --- Stores ---
    match /stores/{storeId} {
      // Public can view stores (for shopping)
      allow read: if true;
      
      // Authenticated users can create a store — a second+ store requires
      // the Growth plan (see isOnGrowthOrHasNoStores above).
      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid
        && isOnGrowthOrHasNoStores();

      // Only the owner can edit their store settings (Name, Theme, etc.)
      // Super Admin can edit anything (Approval, Suspension, etc.)
      // Theme (colors/fonts/hero/footer) is Growth-only — the settings UI
      // disables the whole styling tab for starter, but that's client-side
      // only, so lock it here too: starter can touch every other field,
      // just not theme.
      allow update: if isSuperAdmin() || (
        isStoreOwner() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isVerified', 'isSuspended', 'onboardingNotes', 'onboardingUpdatedAt', 'onboardingReviewerId'])
        && (resource.data.plan == 'growth' || request.resource.data.theme == resource.data.theme)
        // onboardingStatus was previously untouched by the blocklist above —
        // an owner could self-write straight to "approved", bypassing admin
        // review entirely. The one legitimate owner-side transition is
        // resubmitting after "needs_more_info" back to "pending" (the
        // settings page does exactly this); everything else (self-approving,
        // un-rejecting, etc.) requires the super admin.
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['onboardingStatus']) ||
          (resource.data.onboardingStatus == 'needs_more_info' && request.resource.data.onboardingStatus == 'pending')
        )
        // Can't flip status to "live" while not yet approved — otherwise an
        // owner could bypass review and still surface in the mobile app's
        // growth+live discovery query (store-switcher.tsx/onboarding.tsx),
        // which doesn't separately check onboardingStatus.
        && (
          request.resource.data.status != 'live' ||
          resource.data.get('onboardingStatus', 'approved') == 'approved'
        )
      );

      allow delete: if isStoreOwner() || isSuperAdmin();

      // Helper for subcollections to check parent store ownership
      function isParentStoreOwner() {
        return isAuthenticated() && get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId == request.auth.uid;
      }

      // -- Products --
      match /products/{productId} {
        allow read: if true;
        // Stock is reserved/released server-side only now (checkout calls
        // initializeOrderPayment/cancelOrderPayment, which use the Admin
        // SDK and bypass these rules) — no public write path needed
        // anymore, including for the `variants` field a public write could
        // never safely cover before.
        allow write: if isParentStoreOwner();
      }
      
      // -- Categories --
      match /categories/{categoryId} {
        allow read: if true;
        allow write: if isParentStoreOwner();
      }
      
      // -- Orders --
      match /orders/{orderId} {
        // Real buyer orders are created server-side only, by the Cloud
        // Functions verified-checkout flow (initializeOrderPayment /
        // confirmOrderPayment / the Paystack webhook), which use the Admin
        // SDK and bypass these rules entirely. The only client write left
        // here is a vendor manually logging their own order (cash/DM sale).
        allow create: if isParentStoreOwner();

        // Store Owner OR The Customer who placed it can read OR Super Admin
        allow read: if isParentStoreOwner() || 
                     (isAuthenticated() && resource.data.userId == request.auth.uid) ||
                     isSuperAdmin();
        
        // Only the store owner can update (e.g. status)
        allow update: if isParentStoreOwner() || isSuperAdmin();
      }
      
      // -- Order Timeline --
      match /orders/{orderId}/timeline/{timelineId} {
        allow create: if isParentStoreOwner();
        allow read: if isParentStoreOwner() || 
                     (isAuthenticated() && get(/databases/$(database)/documents/stores/$(storeId)/orders/$(orderId)).data.userId == request.auth.uid) ||
                     isSuperAdmin();
      }

      // -- Reviews --
      match /reviews/{reviewId} {
        // Anyone can read reviews
        allow read: if true;
        // Only authenticated users can create reviews
        allow create: if isAuthenticated();
        // Only Store Owner or Admin can update (moderation)
        allow update, delete: if isParentStoreOwner() || isSuperAdmin();
      }

      // -- Complaints --
      match /complaints/{complaintId} {
        // Anyone can file a complaint
        allow create: if true;
        
        // Only the Store Owner or Super Admin can read or update (resolve) complaints
        allow read, update: if isParentStoreOwner() || isSuperAdmin();
      }

      // -- Wallet & Transactions -- (Sensitive, Owner or Super Admin Only)
      match /wallet/{document=**} {
        allow read: if isParentStoreOwner() || isSuperAdmin();
      }
      match /wallet_transactions/{transactionId} {
        allow read: if isParentStoreOwner() || isSuperAdmin();
      }

      // -- Vendor Tickets (To Platform) --
      match /tickets/{ticketId} {
        allow create: if isParentStoreOwner();
        allow read: if isParentStoreOwner() || isSuperAdmin();
        allow update: if isSuperAdmin(); // Admins resolve tickets
      }

      // -- Services (For service-based stores) --
      match /services/{serviceId} {
        allow read: if true; // Public can view services
        allow create, update, delete: if isParentStoreOwner();
      }

      // -- Availability Settings (Store schedule) --
      match /availability/{docId} {
        allow read: if true; // Public can check available slots
        allow create, update, delete: if isParentStoreOwner();
      }

      // -- Bookings (Appointments) --
      match /bookings/{bookingId} {
        // Anyone can create a booking (public checkout)
        allow create: if true;
        
        // Store Owner can read all bookings for their store
        // Authenticated customers can read their own bookings
        allow read: if isParentStoreOwner() ||
          (isAuthenticated() && resource.data.customerId == request.auth.uid) ||
          isSuperAdmin();
        
        // Only the store owner can update (confirm, cancel, complete)
        allow update: if isParentStoreOwner();
        
        // Store owner can delete bookings
        allow delete: if isParentStoreOwner();
      }
    }

    // --- Notifications (Root) ---
    match /notifications/{notificationId} {
        allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.userId == 'all');
        allow create: if isAuthenticated();
        // User can mark their own notifications as read
        allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Default Deny (Block everything else)
    match /{document=**} {
      allow read, write: if false;
    }
    
    // --- Collection Groups (Global Search/Listing) ---
    match /{path=**}/complaints/{complaintId} {
      allow read: if isSuperAdmin();
    }
    match /{path=**}/tickets/{ticketId} {
      allow read: if isSuperAdmin();
    }
    match /{path=**}/orders/{orderId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isSuperAdmin();
    }
    match /{path=**}/notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    match /{path=**}/products/{productId} {
      allow read: if true;
    }
    match /{path=**}/services/{serviceId} {
      allow read: if true;
    }
    match /{path=**}/bookings/{bookingId} {
      allow read: if (isAuthenticated() && resource.data.customerId == request.auth.uid) || isSuperAdmin();
    }
  }
}
